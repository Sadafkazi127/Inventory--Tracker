# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# MySQL connection string, e.g. mysql://user:password@localhost:3306/shopmaster
DATABASE_URL=mysql://root:password@localhost:3306/shopmaster

# Long random string used to sign JWTs — generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret
